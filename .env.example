# Supabase Frontend Credentials — copy this file to .env and fill in your values
# Get these from: https://app.supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Edge Functions Secrets
# Set these in Supabase Dashboard → Edge Functions → Secrets
# OR set locally via CLI: npx supabase secrets set QR_JWT_SECRET="your-secret-key"
#
# SUPABASE_URL=https://your-supabase-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# QR_JWT_SECRET=super-secret-random-jwt-key-minimum-32-chars
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173
# WEBAUTHN_RP_NAME=Attendance System
